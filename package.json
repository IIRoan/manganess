{
  "name": "manganess",
  "main": "expo-router/entry",
  "version": "1.15",
  "expo": {
    "version": "1.15",
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  },
  "scripts": {
    "start": "expo start",
    "startlocal": "expo start --localhost",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "lint:fix": "expo lint --fix",
    "typecheck": "tsc --noEmit",
    "build": "eas build -p android --profile preview",
    "build:ios": "eas build -p ios --profile preview",
    "build:android": "eas build -p android --profile preview",
    "build:development": "eas build --profile development",
    "build:ios:testing": "eas build -p ios --profile testing",
    "build:android:testing": "eas build -p android --profile testing",
    "dev": "APP_VARIANT=development expo start --dev-client",
    "dev:lan": "APP_VARIANT=development expo start --lan --dev-client",
    "dev:go": "expo start --go",
    "prebuild": "expo prebuild --clean",
    "export": "expo export",
    "update:preview": "eas update --branch preview --environment preview",
    "update:main": "eas update --branch main --environment production",
    "check": "bun run lint && bun run typecheck",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "doctor": "bunx expo-doctor"
  },
  "dependencies": {
    "@babel/runtime": "^7.26.0",
    "@expo/metro-runtime": "~57.0.10",
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/bottom-sheet": "^5.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@shopify/flash-list": "2.0.2",
    "@zedux/react": "^1.3.5",
    "axios": "1.19.0",
    "expo": "^57.0.0",
    "expo-background-fetch": "~57.0.10",
    "expo-blur": "~57.0.2",
    "expo-constants": "~57.0.11",
    "expo-dev-client": "~57.0.12",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.4",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.3",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.6",
    "expo-router": "~57.0.13",
    "expo-sharing": "~57.0.12",
    "expo-splash-screen": "~57.0.6",
    "expo-system-ui": "~57.0.2",
    "expo-task-manager": "~57.0.10",
    "expo-updates": "~57.0.14",
    "expo-web-browser": "~57.0.2",
    "html-entities": "^2.5.2",
    "lodash": "^4.17.21",
    "lodash.debounce": "^4.0.8",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@testing-library/react-hooks": "^8.0.1",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/lodash": "^4.17.20",
    "@types/react": "~19.2.10",
    "baseline-browser-mapping": "^2.9.19",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.1",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.4",
    "prettier": "^3.5.3",
    "react-test-renderer": "19.2.8",
    "typescript": "~5.9.2"
  },
  "private": true
}
