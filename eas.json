{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "bun": "1.3.14",
      "env": {
        "APP_VARIANT": "development",
        "EXPO_PUBLIC_MANGA_API_URL": "https://mangafire.to"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "bun": "1.3.14",
      "env": {
        "APP_VARIANT": "preview",
        "EXPO_PUBLIC_MANGA_API_URL": "https://mangafire.to"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "channel": "main",
      "bun": "1.3.14",
      "env": {
        "APP_VARIANT": "production",
        "EXPO_PUBLIC_MANGA_API_URL": "https://mangafire.to"
      }
    },
    "testing": {
      "extends": "development"
    }
  }
}
